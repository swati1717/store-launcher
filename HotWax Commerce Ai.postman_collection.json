      "name": "Single Location",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Shopify-Access-Token",
            "value": "<YOUR_SHOPIFY_ACCESS_TOKEN>",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"mutation locationAdd($input: LocationAddInput!) { locationAdd(input: $input) { location { id name } userErrors { field message } } }\",\n  \"variables\": {\n    \"input\": {\n      \"name\": \"{{name}}\",\n      \"address\": {\n        \"address1\": \"{{address1}}\",\n        \"city\": \"{{city}}\",\n        \"provinceCode\": \"{{provinceCode}}\",\n        \"countryCode\": \"{{countryCode}}\",\n        \"zip\": \"{{zip}}\"\n      },\n      \"fulfillsOnlineOrders\": true\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
